FROM mcr.microsoft.com/playwright/python:v1.49.1-jammy

WORKDIR /app
RUN pip install --no-cache-dir \
      playwright==1.49.1 \
      fastapi==0.115.6 \
      "uvicorn[standard]==0.32.1" \
      pydantic==2.10.3

COPY api/browser_service.py /app/browser_service.py

ENV DESK_ROOT=/desk
ENV PYTHONUNBUFFERED=1

EXPOSE 5766
CMD ["uvicorn", "browser_service:app", "--host", "0.0.0.0", "--port", "5766"]
